# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL — localhost for `npm run dev`; set production URL in Vercel env only
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar connect (NOT the same as Supabase “Sign in with Google”)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# Production app URL (shows in Calendar OAuth setup hint alongside localhost)
# GOOGLE_OAUTH_PRODUCTION_APP_URL=https://your-app.vercel.app

# Microsoft Outlook calendar
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Public HTTPS base for Recall voice agent + live transcript webhooks (required for talking bot)
# Local: npm run recall:tunnel (Cloudflare quick tunnel — no localtunnel IP gate for Recall bots)
# RECALL_PUBLIC_APP_URL=https://your-subdomain.trycloudflare.com
# RECALL_TEST_BOT_NAME=Adsense John
# Sign up: https://www.recall.ai/ → API keys (note your region)
RECALL_API_KEY=
RECALL_REGION=ap-northeast-1
# Optional: override if Recall gives a custom base URL
# RECALL_API_BASE=https://us-west-2.recall.ai
# In Recall → Webhooks (same region), add: https://YOUR_APP/api/webhooks/recall
# RECALL_WEBHOOK_SECRET=
# Live transcript during calls (per-bot webhook, auto-configured on Create Bot):
# https://YOUR_APP/api/webhooks/recall/realtime/?token=YOUR_CRON_SECRET
# RECALL_REALTIME_WEBHOOK_TOKEN=

# Google Meet signed-in bot (Recall Google Login Group — not your personal Google account)
# Step 1: npm run recall:google-group
# Step 2–3: Workspace SSO + npm run recall:google-login-add
# RECALL_GOOGLE_LOGIN_GROUP_ID=
# Set true only after npm run recall:google-login-add (or dashboard Google Logins):
# RECALL_GOOGLE_LOGIN_ENABLED=true
# RECALL_GOOGLE_LOGIN_GROUP_NAME=MeetMind Bot Group
# RECALL_GOOGLE_LOGIN_MODE=always
# RECALL_GOOGLE_LOGIN_EMAIL=bot@yourdomain.com
# RECALL_GOOGLE_WORKSPACE_DOMAIN=yourdomain.com
# RECALL_GOOGLE_SSO_PRIVATE_KEY_PATH=./secrets/recall-google-sso.key.pem
# RECALL_GOOGLE_SSO_CERT_PATH=./secrets/recall-google-sso.cert.pem

# AI summaries & Q&A — xAI (Grok) or OpenAI (OpenAI-compatible client)
# XAI_API_KEY=
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_CHAT_MODEL=grok-3-mini-fast
OPENAI_API_KEY=

# Live voice agent (Recall Output Media + Grok Voice or OpenAI Realtime WebRTC)
# Requires RECALL_PUBLIC_APP_URL (npm run recall:tunnel locally).
# RECALL_VOICE_AGENT_ENABLED=true
# RECALL_VOICE_AGENT_PROVIDER=xai
# RECALL_VOICE_AGENT_NAME=John
# RECALL_VOICE_AGENT_TEAM=AdSense team
# RECALL_VOICE_AGENT_GREETING=Hi, my name is John from the AdSense team. Nice to meet you.
# RECALL_VOICE_AGENT_VOICE=eve
# RECALL_VOICE_AGENT_MODEL=grok-voice-latest
# RECALL_VOICE_AGENT_INSTRUCTIONS=You are John from the AdSense team…
# VOICE_AGENT_SECRET=

# Follow-up email (optional)
RESEND_API_KEY=

# Cron / webhooks
CRON_SECRET=
BOT_SIMULATION_SECRET=

# Local seed script (optional)
# DEV_TEST_EMAIL=demo@meetmind.test
# DEV_TEST_PASSWORD=
# SUPABASE_DB_URL=postgresql://...  # for npm run db:fix
