# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL — localhost for `npm run dev`; set production URL in Vercel env only
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar connect (NOT the same as Supabase “Sign in with Google”)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# Microsoft Outlook calendar
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Meeting bots (optional — uses simulation when unset)
RECALL_API_KEY=

# AI summaries & Q&A (optional)
OPENAI_API_KEY=

# Follow-up email (optional)
RESEND_API_KEY=

# Cron / webhooks
CRON_SECRET=
BOT_SIMULATION_SECRET=

# Local seed script (optional)
# DEV_TEST_EMAIL=demo@meetmind.test
# DEV_TEST_PASSWORD=
# SUPABASE_DB_URL=postgresql://...  # for npm run db:fix
